POSTGRES_PASSWORD=replace-with-random-local-password
DATABASE_URL=postgresql+asyncpg://notification:replace-with-random-local-password@postgres:5432/notification
RABBITMQ_USER=notification
RABBITMQ_PASSWORD=replace-with-random-local-password
RABBITMQ_URL=amqp://notification:replace-with-random-local-password@rabbitmq:5672/
AUTH_URL=http://host.docker.internal:8000
AUTH_READER_TOKEN=replace-with-unique-random-reader-token
SERVICE_TOKENS={"auth":"replace-with-unique-random-auth-token","catalog":"replace-with-unique-random-catalog-token","operator":"replace-with-unique-random-operator-token"}
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=cinema@example.org
SMTP_START_TLS=false
SMTP_USE_TLS=false
CONCURRENCY=5

